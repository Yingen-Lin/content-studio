PORT=4180
APP_ORIGIN=http://127.0.0.1:4180
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the Google Cloud OAuth web client redirect URI exactly.
GOOGLE_REDIRECT_URI=http://127.0.0.1:4180/auth/google/callback
# Optional initial folder. Keep real folder IDs out of source control.
DEFAULT_DRIVE_FOLDER_ID=
# Optional: restrict sign-in to your Google account email.
ALLOWED_GOOGLE_EMAIL=

# Optional database path. Default: .local/content-studio.sqlite
# LIBRARY_DB_PATH=/absolute/path/to/content-studio.sqlite

# Hosted Vercel deployment only (omit for local SQLite preview):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# SESSION_ENCRYPTION_KEY=32-random-bytes-in-base64url
